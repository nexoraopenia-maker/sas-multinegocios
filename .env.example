# Copia este archivo como .env.local (desarrollo) o configura estas variables en Vercel (producción).
# Nunca subas valores reales al repositorio.

# --- Base de datos (Neon) ---
# Conexión de la APLICACIÓN: rol "saas_app" (sin BYPASSRLS), usando el host con "-pooler".
DATABASE_URL="postgresql://saas_app:CONTRASENA_DEL_ROL_APP@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Conexión del PROPIETARIO (solo migraciones y scripts), host directo (sin "-pooler").
DIRECT_URL="postgresql://neondb_owner:CONTRASENA_PROPIETARIO@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Primer SuperAdmin (solo para `npm run superadmin:create`; bórralas después) ---
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# --- Cuenta de demostración (opcional, solo para `npm run db:seed:demo`) ---
# Vacías: usa demo@tienda-demo.example y genera una contraseña temporal que se muestra una sola vez.
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""

# --- Agente de IA (opcional) ---
ANTHROPIC_API_KEY=""
# Modelo usado por el agente. Su precio debe existir en SuperAdmin > Modelos de IA.
AI_MODEL="claude-haiku-5-5"

# --- Cifrado de secretos de facturación electrónica (opcional, fase SUNAT) ---
# 32 bytes en base64. Generar con: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# --- Pruebas automáticas (opcional) ---
# El nombre de la base DEBE contener "test": su contenido se BORRA en cada ejecución.
# Usa un servidor local o una rama de Neon aparte: las pruebas fijan la contraseña del rol saas_app en ese servidor.
TEST_DATABASE_URL="postgresql://saas_app:saas_app_test@localhost:5432/saas_test"
TEST_DIRECT_URL="postgresql://usuario_propietario@localhost:5432/saas_test"
